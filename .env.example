# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/voltcards?schema=public"

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-random-32-byte-base64
BETTER_AUTH_URL=http://localhost:3000

# --- Superadmin seed ---
SEED_SUPERADMIN_EMAIL=admin@voltaiagents.com
SEED_SUPERADMIN_PASSWORD=ChangeMe!2026
SEED_SUPERADMIN_NAME="Super Admin"

# --- Cloudflare R2 (S3 compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=volt-cards
# Public base URL for the bucket (e.g. https://pub-xxx.r2.dev or your custom domain)
R2_PUBLIC_URL=

# --- Store / WhatsApp checkout (landing) ---
# E.164 digits only, country code included
NEXT_PUBLIC_WHATSAPP_NUMBER=5493794789169
