// Volt Cards V1 - Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- AUTH (Better Auth tables) ----------
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(USER)
  profile       Profile?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

enum Role {
  SUPERADMIN
  USER
}

// ---------- PROFILE (public card content) ----------
enum Template {
  MINIMAL
  PREMIUM
  CORPORATE
}

enum ThemeMode {
  LIGHT
  DARK
}

enum LinkKind {
  WEBSITE
  INSTAGRAM
  LINKEDIN
  TWITTER
  FACEBOOK
  YOUTUBE
  TIKTOK
  GITHUB
  SPOTIFY
  CALENDAR
  EMAIL
  PHONE
  WHATSAPP
  MAP
  PDF
  OTHER
}

model Profile {
  id           String   @id @default(cuid())
  slug         String   @unique
  active       Boolean  @default(true)

  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName     String
  jobTitle     String?
  companyName  String?
  description  String?
  email        String?
  phone        String?
  whatsapp     String?
  website      String?
  avatarUrl    String?
  coverUrl     String?
  location     String?
  locationLat  Float?
  locationLng  Float?

  instagram    String?
  linkedin     String?
  twitter      String?
  facebook     String?
  youtube      String?
  tiktok       String?
  github       String?

  template     Template @default(MINIMAL)
  primaryColor String   @default("#0F172A")
  themeMode    ThemeMode @default(LIGHT)

  links        Link[]
  card         NfcCard?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("profiles")
}

model Link {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind      LinkKind @default(WEBSITE)
  label     String
  url       String
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("links")
}

// ---------- NFC CARDS ----------
enum CardStatus {
  UNASSIGNED
  ACTIVE
  INACTIVE
  LOST
}

model NfcCard {
  id           String     @id @default(cuid())
  code         String     @unique
  status       CardStatus @default(UNASSIGNED)
  profileId    String?    @unique
  profile      Profile?   @relation(fields: [profileId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("nfc_cards")
}
